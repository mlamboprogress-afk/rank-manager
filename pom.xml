<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>za.co.taxirankmanager</groupId>
    <artifactId>taxi-rank-manager</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Taxi Rank Manager</name>
    <description>Digital taxi rank queue management platform for South African taxi ranks</description>

    <modules>
        <module>modules/shared-kernel</module>
        <module>modules/identity</module>
        <module>modules/rank</module>
        <module>modules/fleet</module>
        <module>modules/route</module>
        <module>modules/queue</module>
        <module>modules/notification</module>
        <module>adapters/inbound-rest</module>
        <module>adapters/inbound-scheduler</module>
        <module>adapters/outbound-postgres</module>
        <module>adapters/outbound-sms</module>
        <module>adapters/outbound-security</module>
        <module>adapters/outbound-clock</module>
        <module>apps/taxi-rank-manager-service</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Quarkus -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.15.1</quarkus.platform.version>

        <!-- Architecture testing -->
        <archunit.version>1.3.0</archunit.version>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.0</maven-failsafe-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus BOM — manages all Quarkus extension and library versions -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>shared-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>module-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>module-rank</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>module-fleet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>module-route</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>module-queue</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>module-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>adapter-inbound-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>adapter-inbound-scheduler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>adapter-outbound-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>adapter-outbound-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>adapter-outbound-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>za.co.taxirankmanager</groupId>
                <artifactId>adapter-outbound-clock</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ArchUnit -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
